<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="600.0" style="-fx-padding: 30;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group4.medical_entrance_exam.zinat.Applicant.ExamCenterController">
   <children>
      <Label alignment="CENTER" layoutX="105.0" layoutY="14.0" prefHeight="70.0" prefWidth="391.0" text="Exam Center" textAlignment="CENTER" textFill="#082c5e" wrapText="true">
         <font>
            <Font name="Bell MT Bold" size="37.0" />
         </font>
      </Label>

      <!-- Entry slip (original offline logic) -->
      <TextArea fx:id="ExamCenterDetailsTA" editable="false" layoutX="58.0" layoutY="90.0" prefHeight="150.0" prefWidth="486.0" />

      <!-- NEW: live seats from the exam server -->
      <Label layoutX="58.0" layoutY="255.0" text="Live seat availability" textFill="#082c5e">
         <font>
            <Font name="Bell MT Bold" size="20.0" />
         </font>
      </Label>
      <TextArea fx:id="SeatsTA" editable="false" layoutX="58.0" layoutY="288.0" prefHeight="120.0" prefWidth="486.0" style="-fx-font-family: 'monospace';" />
      <Label fx:id="ServerStatusLabel" layoutX="58.0" layoutY="414.0" prefWidth="486.0" text="● Connecting to exam server..." textFill="#555555">
         <font>
            <Font name="Bell MT Bold" size="16.0" />
         </font>
      </Label>

      <!-- NEW: choose a center and book -->
      <ComboBox fx:id="CenterChoiceCB" layoutX="58.0" layoutY="455.0" prefHeight="40.0" prefWidth="220.0" promptText="Choose exam center" />
      <Button fx:id="BookSeatBTN" layoutX="300.0" layoutY="455.0" mnemonicParsing="false" onAction="#BookSeatOA" prefHeight="40.0" style="-fx-background-color: #082c5e;" text="Book my seat" textFill="WHITE">
         <font>
            <Font name="Bell MT Bold" size="20.0" />
         </font>
      </Button>

      <Button layoutX="97.0" layoutY="540.0" mnemonicParsing="false" onAction="#ReVerifyCenterAllocationOA" style="-fx-background-color: #006643;" text="🔄 Re-verify Active Allocation Path" textFill="WHITE">
         <font>
            <Font name="Bell MT Bold" size="24.0" />
         </font>
      </Button>
      <Label fx:id="CenterAllocationLabel" alignment="TOP_CENTER" contentDisplay="TOP" layoutX="50.0" layoutY="620.0" prefHeight="127.0" prefWidth="500.0" text="STATUS: Choose a center and press Book my seat." textAlignment="CENTER" textFill="#068053" wrapText="true">
         <font>
            <Font name="Bell MT Bold" size="22.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
